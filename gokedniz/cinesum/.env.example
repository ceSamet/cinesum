# CineSum optional narrative LLM configuration
# Copy this file as .env and replace only the placeholder value.
PARALON_API_KEY=prlc_your_key_here
PARALON_BASE_URL=https://paraloncloud.com/v1
PARALON_MODEL=gemma3-4b-mac
PARALON_TIMEOUT_SEC=60

# Optional local visual semantics for the bounded RAG/LLM candidate shortlist.
VLM_ENABLED=true
VLM_BLIP_MODEL=Salesforce/blip-image-captioning-base
VLM_LLAVA_MODEL=llava-hf/llava-onevision-qwen2-0.5b-ov-hf
VLM_MAX_FRAMES=40
VLM_LLAVA_MAX_FRAMES=12
VLM_TIME_BUDGET_SEC=60
