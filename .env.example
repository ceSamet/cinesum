# Get a free/paid Gemini API key from Google AI Studio, then copy this file to .env.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override in CLI with --model.
GEMINI_MODEL=gemini-3.6-flash

# ParalonCloud RAG destekli sahne seçimi (anahtar prlc_ ile başlar).
PARALON_API_KEY=prlc_your_key_here
PARALON_BASE_URL=https://paraloncloud.com/v1
PARALON_MODEL=qwen3.8-27b
